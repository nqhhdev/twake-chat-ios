# Log to stdout only. The official Synapse image writes /data/localhost.log.config
# here; we ship it so `generate` is not required (and so /data can be a writable
# named volume with this file mounted read-only).
version: 1

formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise

loggers:
  _placeholder:
    level: INFO
  synapse.storage.SQL:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
