{
  "sourceLanguage": "en",
  "strings": {
    "%@ changed the chat avatar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a changé l’image de la discussion"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã đổi ảnh cuộc trò chuyện"
          }
        }
      }
    },
    "%@ changed the chat description to: '%@'": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a changé la description de la discussion : « %2$@ »"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã đổi mô tả cuộc trò chuyện thành: “%2$@”"
          }
        }
      }
    },
    "%@ changed the chat name to: '%@'": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a renommé la discussion : « %2$@ »"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã đổi tên cuộc trò chuyện thành: “%2$@”"
          }
        }
      }
    },
    "%@ changed the chat permissions": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a changé les permissions de la discussion"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã thay đổi quyền trong cuộc trò chuyện"
          }
        }
      }
    },
    "%@ changed the guest access rules": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a changé les règles d’accès à la discussion pour les invités"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã thay đổi quy tắc truy cập đối với khách"
          }
        }
      }
    },
    "%@ changed the history visibility to: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a changé la visibilité de l’historique de la discussion en : %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã thay đổi chế độ hiển thị lịch sử thành: %2$@"
          }
        }
      }
    },
    "%@ changed the join rules": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a changé les règles d’accès à la discussion"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã thay đổi quy tắc tham gia"
          }
        }
      }
    },
    "%@ changed the join rules to: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a changé les règles d’accès à la discussion en : %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã thay đổi quy tắc tham gia thành: %2$@"
          }
        }
      }
    },
    "%@ rejected the invitation": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé l’invitation"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã từ chối lời mời"
          }
        }
      }
    },
    "%@ removed the chat description": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a supprimé la description de la discussion"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã xóa mô tả cuộc trò chuyện"
          }
        }
      }
    },
    "%@ unbanned %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a levé le bannissement de %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã bỏ cấm %2$@"
          }
        }
      }
    },
    "Anyone can ask to join": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut demander à rejoindre"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng có thể xin tham gia"
          }
        }
      }
    },
    "Anyone can join": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut rejoindre"
          }
        },
        "vi": {
