    "Admins can change the chat and people's roles; moderators can remove and ban members.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les administrateurs peuvent modifier la discussion et les rôles ; les modérateurs peuvent retirer et bannir des membres."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản trị viên có thể sửa cuộc trò chuyện và vai trò; người kiểm duyệt có thể xóa và cấm thành viên."
          }
        }
      }
    },
    "Admins with different rights": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des administrateurs aux droits différents"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản trị viên với các quyền khác nhau"
          }
        }
      }
    },
    "All messages": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả tin nhắn"
          }
        }
      }
    },
    "All pinned messages": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages épinglés"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả tin nhắn đã ghim"
          }
        }
      }
    },
    "Allow Twake Chat to add to Photos in Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Twake Chat à ajouter des éléments à Photos dans Réglages."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép Twake Chat thêm vào Ảnh trong Cài đặt."
          }
        }
      }
    },
    "Allow Twake Chat to use the microphone in Settings to record voice messages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Twake Chat à utiliser le micro dans Réglages pour enregistrer des messages vocaux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép Twake Chat dùng micrô trong Cài đặt để ghi tin nhắn thoại."
          }
        }
      }
    },
    "Allow speech recognition for Twake Chat in Settings to transcribe voice messages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la reconnaissance vocale pour Twake Chat dans Réglages pour transcrire les messages vocaux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép nhận dạng giọng nói cho Twake Chat trong Cài đặt để chép lời tin nhắn thoại."
          }
        }
      }
    },
    "An encrypted chat cannot be opened to anyone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion chiffrée ne peut pas être ouverte à tous."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện được mã hóa không thể mở cho mọi người."
          }
        }
      }
    },
    "Anyone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người"
          }
        }
      }
    },
    "Anyone can ask": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut demander"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng có thể xin"
          }
        }
      }
    },
    "Are you sure you want to leave the chat?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment quitter la discussion ?"
          }
        },
        "vi": {
          "stringUnit": {
