            "value": "Tìm kiếm"
          }
        }
      }
    },
    "Search for people by name or Matrix ID, such as @alice:example.org.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez des personnes par nom ou identifiant Matrix, par exemple @alice:example.org."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm người theo tên hoặc Matrix ID, ví dụ @alice:example.org."
          }
        }
      }
    },
    "Search for people by name, Matrix ID, e-mail or phone number.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez des personnes par nom, identifiant Matrix, e-mail ou numéro de téléphone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm người theo tên, Matrix ID, email hoặc số điện thoại."
