{
  "sourceLanguage": "en",
  "strings": {
    "%@ Listed in the directory; you approve who follows.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Listé dans l’annuaire ; vous approuvez qui le suit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Có trong danh bạ; bạn duyệt người theo dõi."
          }
        }
      }
    },
    "%@ Listed in the server's directory; anyone can read it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Listé dans l’annuaire du serveur ; tout le monde peut le lire."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Có trong danh bạ của máy chủ; ai cũng có thể đọc."
          }
        }
      }
    },
    "%@ Only the people you invite follow it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Seules les personnes que vous invitez le suivent."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Chỉ những người bạn mời mới theo dõi được."
          }
        }
      }
    },
