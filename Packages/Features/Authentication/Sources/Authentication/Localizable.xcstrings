{
  "sourceLanguage": "en",
  "strings": {
    "An open source messenger encrypt\nyour data with matrix protocol": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messager open source qui crypte\nvos données avec le protocole matrix"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng nhắn tin mã nguồn mở mã hóa\ndữ liệu của bạn bằng giao thức Matrix"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir en arrière"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay lại"
          }
        }
      }
    },
    "By continuing, you're agreeing to our": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez notre"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng cách tiếp tục, bạn đồng ý với chúng tôi"
          }
        }
      }
    },
    "Can't open your session": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir votre session"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở phiên của bạn"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục"
          }
        }
      }
    },
    "Could not log out. Please try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se déconnecter. Veuillez réessayer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đăng xuất. Vui lòng thử lại."
          }
        }
      }
    },
    "Create Twake ID": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer un Twake ID"
          }
        },
        "vi": {
