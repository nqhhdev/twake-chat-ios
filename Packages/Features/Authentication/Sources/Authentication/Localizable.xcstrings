    "Server address was sent to you by company admin. Check the invitation email.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse du serveur vous a été envoyée par l'administrateur de l'entreprise. Vérifiez le message d'invitation."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ máy chủ đã được quản trị viên gửi cho bạn. Vui lòng kiểm tra email mời."
          }
        }
      }
    },
    "Sign in": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
