            "state": "translated",
            "value": "Tạo Twake ID"
          }
        }
      }
    },
    "Enter your homeserver": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renseignez l'adresse de votre serveur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập máy chủ của bạn"
          }
        }
      }
    },
