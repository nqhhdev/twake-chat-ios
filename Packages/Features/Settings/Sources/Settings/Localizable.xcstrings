    },
    "Verify this device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier cet appareil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh thiết bị này"
          }
        }
      }
    },
    "Verify with another device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier avec un autre appareil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh bằng thiết bị khác"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản %@"
          }
        }
      }
    },
    "We sent a code to %@. Enter it to confirm the number is yours.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un code au %@. Saisissez-le pour confirmer que ce numéro est le vôtre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã gửi mã tới %@. Hãy nhập mã để xác nhận số này là của bạn."
          }
        }
      }
    },
    "We sent a link to %@. Open it, then come back here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un lien à %@. Ouvrez-le, puis revenez ici."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã gửi liên kết tới %@. Hãy mở rồi quay lại đây."
          }
        }
      }
    },
    "We will send a code to this number by text message to confirm it is yours.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons un code par SMS à ce numéro pour confirmer qu’il est le vôtre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ gửi mã qua tin nhắn tới số này để xác nhận đó là số của bạn."
          }
        }
      }
    },
    "We will send a link to this address to confirm it is yours.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons un lien à cette adresse pour confirmer qu’elle est la vôtre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ gửi liên kết tới địa chỉ này để xác nhận đó là của bạn."
          }
        }
      }
    },
    "What are you up to?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que faites-vous ?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang làm gì?"
          }
        }
      }
    },
    "Who sees my e-mail and phone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui voit mon e-mail et mon téléphone"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai thấy email và số điện thoại của tôi"
          }
        }
      }
    },
    "Who sees them": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui les voit"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai thấy chúng"
          }
        }
      }
    },
    "Wrong password, or the reset failed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe incorrect, ou la réinitialisation a échoué."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai mật khẩu, hoặc việc đặt lại thất bại."
          }
        }
      }
    },
    "Wrong recovery key": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé de récupération incorrecte"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai khóa khôi phục"
          }
        }
      }
    },
    "Your account is closed for good: you leave every chat, sign out of every device and lose your encrypted messages. Nobody can use your Matrix ID again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est fermé définitivement : vous quittez toutes les discussions, êtes déconnecté de tous vos appareils et perdez vos messages chiffrés. Personne ne pourra réutiliser votre identifiant Matrix."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn bị đóng vĩnh viễn: bạn rời mọi cuộc trò chuyện, đăng xuất khỏi mọi thiết bị và mất các tin nhắn mã hóa. Không ai có thể dùng lại Matrix ID của bạn."
          }
        }
      }
    },
    "Your account is managed on your organisation's settings page.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est géré sur la page de paramètres de votre organisation."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn được quản lý trên trang cài đặt của tổ chức."
          }
        }
      }
    },
    "Your identity was reset. Set up the chat backup again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identité a été réinitialisée. Configurez à nouveau la sauvegarde des discussions."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh tính của bạn đã được đặt lại. Hãy thiết lập lại sao lưu trò chuyện."
          }
        }
      }
    },
    "Your messages are encrypted. The recovery key unlocks older messages on a new device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos messages sont chiffrés. La clé de récupération déverrouille les anciens messages sur un nouvel appareil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn của bạn được mã hóa. Khóa khôi phục mở khóa tin nhắn cũ trên thiết bị mới."
          }
        }
      }
    },
    "Your personal QR": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre QR personnel"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã QR của bạn"
          }
        }
      }
    },
    "“%@” wants to verify this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » veut vérifier cet appareil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” muốn xác minh thiết bị này."
          }
        }
      }
    }
  },
  "version": "1.0"
}
