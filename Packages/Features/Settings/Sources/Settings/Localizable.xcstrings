    "Changes to a chat's encryption, description, join rules, history or permissions.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications du chiffrement, de la description, des règles d’accès, de l’historique ou des permissions d’une discussion."
