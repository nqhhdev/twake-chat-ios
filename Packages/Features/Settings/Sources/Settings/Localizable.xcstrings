{
  "sourceLanguage": "en",
  "strings": {
    "A verified device is trusted by your other devices and can read your older encrypted messages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil vérifié est approuvé par vos autres appareils et peut lire vos anciens messages chiffrés."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị đã xác minh được các thiết bị khác của bạn tin cậy và có thể đọc các tin nhắn mã hóa cũ."
          }
        }
      }
    },
