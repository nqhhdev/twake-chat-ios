            "state": "translated",
            "value": "Ứng dụng Twake"
          }
        }
      }
    },
    "Twake Chat asks for %@ when it opens and each time you come back to it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twake Chat demande %@ à l’ouverture et à chaque retour dans l’app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twake Chat yêu cầu %@ khi mở và mỗi lần bạn quay lại ứng dụng."
          }
        }
      }
    },
    "Twake Chat counts which screens and actions you use, to improve the app. It never sends your messages, names, contacts or files.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twake Chat compte les écrans et actions que vous utilisez, pour améliorer l’app. Il n’envoie jamais vos messages, noms, contacts ni fichiers."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twake Chat đếm những màn hình và thao tác bạn dùng để cải thiện ứng dụng. Ứng dụng không bao giờ gửi tin nhắn, tên, danh bạ hay tệp của bạn."
          }
        }
      }
    },
