{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already signed in on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà connecté sur cet appareil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã đăng nhập trên thiết bị này."
          }
        }
      }
    },
    "Account not added": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte non ajouté"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thêm tài khoản"
          }
        }
      }
    },
    "Accounts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptes"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản"
          }
        }
      }
    },
    "Add account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un compte"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tài khoản"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy"
          }
        }
      }
    },
    "Chat with %@?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuter avec %@ ?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện với %@?"
          }
        }
      }
    },
    "Chats": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussions"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn"
          }
        }
      }
    },
    "Contacts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên hệ"
          }
        }
      }
    },
    "Copy ID": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier l’identifiant"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép ID"
          }
        }
      }
    },
    "Could not join this chat. Please try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rejoindre cette discussion. Veuillez réessayer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tham gia cuộc trò chuyện này. Vui lòng thử lại."
          }
        }
      }
    },
    "Could not log out. Please try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se déconnecter. Veuillez réessayer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đăng xuất. Vui lòng thử lại."
          }
        }
      }
    },
    "Could not open the chat with %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir la discussion avec %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở cuộc trò chuyện với %@."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong"
          }
        }
      }
    },
    "Enter recovery key": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisir la clé de récupération"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập khóa khôi phục"
          }
        }
      }
    },
    "Enter your recovery key to read the encrypted messages sent before you signed in here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre clé de récupération pour lire les messages chiffrés envoyés avant votre connexion sur cet appareil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập khóa khôi phục để đọc các tin nhắn mã hóa được gửi trước khi bạn đăng nhập ở đây."
          }
        }
      }
    },
    "Join": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham gia"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau"
          }
        }
      }
    },
    "Mark as read": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer comme lu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu là đã đọc"
          }
        }
      }
    },
    "Message": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Reply": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời"
          }
        }
      }
    },
    "Search chats": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des discussions"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm cuộc trò chuyện"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi"
          }
        }
      }
    },
    "Send to": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer à"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi tới"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt"
          }
        }
      }
    },
    "This chat could not be found.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion est introuvable."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy cuộc trò chuyện này."
          }
        }
      }
    },
    "This chat is private: someone in it has to invite you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion est privée : un de ses membres doit vous inviter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện này là riêng tư: cần có người trong đó mời bạn."
          }
        }
      }
    },
    "This device was signed out from another device. Sign in again to continue.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil a été déconnecté depuis un autre appareil. Reconnectez-vous pour continuer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này đã bị đăng xuất từ một thiết bị khác. Hãy đăng nhập lại để tiếp tục."
          }
        }
      }
    },
    "Turn off App Lock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le verrouillage de l’app"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt khóa ứng dụng"
          }
        }
      }
    },
    "Turn on App Lock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le verrouillage de l’app"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật khóa ứng dụng"
          }
        }
      }
    },
    "Twake Chat is locked": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twake Chat est verrouillé"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twake Chat đang bị khóa"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouiller"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa"
          }
        }
      }
    },
    "Unlock Twake Chat": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouiller Twake Chat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa Twake Chat"
          }
        }
      }
    },
    "Unlock your encrypted messages": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez vos messages chiffrés"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa tin nhắn được mã hóa"
          }
        }
      }
    },
    "Verify this device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier cet appareil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh thiết bị này"
          }
        }
      }
    },
    "Verify this device with another one, or with your recovery key, to read your encrypted messages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez cet appareil avec un autre appareil, ou avec votre clé de récupération, pour lire vos messages chiffrés."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác minh thiết bị này bằng một thiết bị khác hoặc bằng khóa khôi phục để đọc tin nhắn được mã hóa."
          }
        }
      }
    },
    "You can add up to %lld accounts.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You can add up to %lld account."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You can add up to %lld accounts."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vous pouvez ajouter jusqu’à %lld compte."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vous pouvez ajouter jusqu’à %lld comptes."
                }
              }
            }
          }
        },
        "vi": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Bạn có thể thêm tối đa %lld tài khoản."
                }
              }
            }
          }
        }
      }
    },
    "You were signed out": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été déconnecté"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã bị đăng xuất"
          }
        }
      }
    },
    "Your reply was not sent. Open the chat to try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse n’a pas été envoyée. Ouvrez la discussion pour réessayer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của bạn chưa được gửi. Hãy mở cuộc trò chuyện để thử lại."
          }
        }
      }
    },
    "newMessageInTwake": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have 1 encrypted message"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez un message chiffré"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có 1 tin nhắn được mã hóa"
          }
        }
      }
    }
  },
  "version": "1.0"
}