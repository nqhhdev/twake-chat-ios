<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>KeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)app.twake.ios.chat</string>
	<key>DefaultHomeserver</key>
	<string>$(TWAKE_DEFAULT_HOMESERVER)</string>
	<key>RegistrationURL</key>
	<string>$(TWAKE_REGISTRATION_URL)</string>
	<key>WorkplaceHomeserver</key>
	<string>$(TWAKE_WORKPLACE_HOMESERVER)</string>
	<key>PushGatewayURL</key>
	<string>$(TWAKE_PUSH_GATEWAY_URL)</string>
	<key>PrivacyURL</key>
	<string>$(TWAKE_PRIVACY_URL)</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Twake Chat uses Face ID to unlock the app when App Lock is on.</string>
	<key>NSCameraUsageDescription</key>
	<string>Twake Chat uses the camera to take pictures and videos you send in a chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Twake Chat records voice messages with the microphone while you hold the record button.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.twake.ios.chat</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>twake.chat</string>
				<string>matrix</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
